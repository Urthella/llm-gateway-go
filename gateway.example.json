{
  "listen": "127.0.0.1:8080",
  "upstreams": {
    "anthropic": { "base_url": "https://api.anthropic.com/v1", "api_key_env": "ANTHROPIC_API_KEY" },
    "ollama": { "base_url": "http://localhost:11434/v1" }
  },
  "models": {
    "smart": [
      { "upstream": "anthropic", "model": "claude-sonnet-5-5" },
      { "upstream": "ollama", "model": "qwen3" }
    ],
    "fast": [
      { "upstream": "anthropic", "model": "claude-haiku-5-5" },
      { "upstream": "ollama", "model": "qwen3" }
    ],
    "local": [{ "upstream": "ollama", "model": "qwen3" }]
  },
  "prices": {
    "claude-sonnet-5-5": { "input": 3, "output": 15 },
    "claude-haiku-5-5": { "input": 1, "output": 5 }
  },
  "keys": {
    "laptop": { "key_env": "GATEWAY_KEY_LAPTOP", "rpm": 120 },
    "ci": { "key_env": "GATEWAY_KEY_CI", "rpm": 20 }
  }
}
